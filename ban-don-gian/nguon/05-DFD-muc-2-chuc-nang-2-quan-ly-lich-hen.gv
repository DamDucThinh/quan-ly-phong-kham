digraph G {
  graph [fontname="Arial", bgcolor="white", pad=0.35, labelloc=t, fontsize=20, label=<<B>DFD MỨC DƯỚI ĐỈNH — CHỨC NĂNG 2: QUẢN LÝ LỊCH HẸN</B><BR/> >, rankdir=LR, nodesep=0.7, ranksep=1.3];
  node [fontname="Arial", color="black"];
  edge [fontname="Arial", fontsize=11.5, arrowsize=0.85, penwidth=1.2];
  BN [shape=box, style="filled,bold", fillcolor="#ffffff", penwidth=1.6, margin="0.25,0.14", fontsize=14, label=<<B>Bệnh nhân</B>>];
  P21 [shape=circle, fixedsize=true, width=1.55, penwidth=1.6, fontsize=13, label=<<B>2.1</B><BR/>Đặt<BR/>lịch hẹn>];
  P22 [shape=circle, fixedsize=true, width=1.55, penwidth=1.6, fontsize=13, label=<<B>2.2</B><BR/>Hủy<BR/>lịch hẹn>];
  D1 [shape=plain, label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7"><TR><TD SIDES="TB" BORDER="2" WIDTH="150"><B>D1</B>  Bác sĩ</TD></TR></TABLE>>];
  D2 [shape=plain, label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7"><TR><TD SIDES="TB" BORDER="2" WIDTH="150"><B>D2</B>  Bệnh nhân</TD></TR></TABLE>>];
  D3 [shape=plain, label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7"><TR><TD SIDES="TB" BORDER="2" WIDTH="150"><B>D3</B>  Lịch hẹn</TD></TR></TABLE>>];
  {rank=same; D1; D2;}
  BN -> P21 [label=<Yêu cầu đặt lịch>];
  P21 -> BN [label=<Thông báo lịch hẹn>];
  BN -> P22 [label=<Yêu cầu hủy lịch>];
  P22 -> BN [label=<Thông báo hủy lịch>];
  D1 -> P21 [];
  D2 -> P21 [];
  P21 -> D3 [];
  P22 -> D3 [dir=both];
}