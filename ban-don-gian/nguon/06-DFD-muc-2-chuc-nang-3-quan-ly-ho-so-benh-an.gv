digraph G {
  graph [fontname="Arial", bgcolor="white", pad=0.35, labelloc=t, fontsize=20, label=<<B>DFD MỨC DƯỚI ĐỈNH — CHỨC NĂNG 3: QUẢN LÝ HỒ SƠ BỆNH ÁN</B><BR/> >, rankdir=LR, nodesep=0.8, ranksep=1.2];
  node [fontname="Arial", color="black"];
  edge [fontname="Arial", fontsize=11.5, arrowsize=0.85, penwidth=1.2];
  BS [shape=box, style="filled,bold", fillcolor="#ffffff", penwidth=1.6, margin="0.25,0.14", fontsize=14, label=<<B>Bác sĩ</B>>];
  P31 [shape=circle, fixedsize=true, width=1.55, penwidth=1.6, fontsize=13, label=<<B>3.1</B><BR/>Ghi nhận<BR/>kết quả khám>];
  P32 [shape=circle, fixedsize=true, width=1.55, penwidth=1.6, fontsize=13, label=<<B>3.2</B><BR/>Tra cứu<BR/>bệnh án>];
  D2 [shape=plain, label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7"><TR><TD SIDES="TB" BORDER="2" WIDTH="150"><B>D2</B>  Bệnh nhân</TD></TR></TABLE>>];
  D4 [shape=plain, label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7"><TR><TD SIDES="TB" BORDER="2" WIDTH="150"><B>D4</B>  Bệnh án</TD></TR></TABLE>>];
  BS -> P31 [label=<Kết quả khám, chẩn đoán>];
  D2 -> P31 [];
  P31 -> D4 [];
  D4 -> P32 [];
  P32 -> BS [label=<Hồ sơ bệnh án>];
}