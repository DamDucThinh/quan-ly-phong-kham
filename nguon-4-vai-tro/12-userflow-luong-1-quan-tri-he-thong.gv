digraph G {
  graph [fontname="Arial", bgcolor="white", pad=0.35, labelloc=t, fontsize=22, label=<<B>USERFLOW — LUỒNG 1: QUẢN TRỊ HỆ THỐNG</B><BR/><FONT POINT-SIZE="14">Người dùng: Quản trị · Ứng với chức năng 1 (1.1 bác sĩ, 1.2 lịch làm việc, 1.3 danh mục thuốc, 1.4 tài khoản)</FONT><BR/> >, rankdir=TB, nodesep=0.55, ranksep=0.5, newrank=true];
  node [fontname="Arial", color="black", fontsize=14, penwidth=1.4, margin="0.18,0.08"];
  edge [fontname="Arial", fontsize=12.5, arrowsize=0.85, penwidth=1.2];
  S [shape=oval, style=bold, penwidth=1.6, label=<<B>Bắt đầu</B><BR/><FONT POINT-SIZE="12">Trang chủ Quản trị [6]</FONT>>];
  Q0 [shape=diamond, fontsize=13, label=<Quản trị<BR/>chọn>];
  P7 [shape=box, style="rounded,bold", penwidth=1.6, label=<<B>[7]</B> Danh sách bác sĩ<BR/><FONT POINT-SIZE="4"> </FONT><BR/><FONT POINT-SIZE="12"><I>CN 1.1 · đọc D1</I></FONT>>];
  P8 [shape=box, style="rounded,bold", penwidth=1.6, label=<<B>[8]</B> Thêm, sửa bác sĩ<BR/><FONT POINT-SIZE="4"> </FONT><BR/><FONT POINT-SIZE="12"><I>Họ tên, chuyên khoa, phòng, SĐT, email, trình độ</I></FONT>>];
  Q1 [shape=diamond, fontsize=13, label=<Thông tin<BR/>hợp lệ?>];
  N1 [shape=note, label=<Báo lỗi dưới<BR/>ô nhập sai>];
  W1 [shape=box, style=filled, fillcolor="#eeeeee", label=<Lưu hồ sơ bác sĩ<BR/><FONT POINT-SIZE="4"> </FONT><BR/><FONT POINT-SIZE="12"><I>Hệ thống · CN 1.1 · ghi D1</I></FONT>>];
  P9 [shape=box, style="rounded,bold", penwidth=1.6, label=<<B>[9]</B> Lịch làm việc bác sĩ<BR/><FONT POINT-SIZE="4"> </FONT><BR/><FONT POINT-SIZE="12"><I>CN 1.2 · các ca trong tuần</I></FONT>>];
  Q2 [shape=diamond, fontsize=13, label=<Ca hợp lệ,<BR/>không trùng?>];
  N2 [shape=note, label=<Báo thiếu thông tin, giờ kết thúc<BR/>không sau giờ bắt đầu, trùng giờ>];
  W2 [shape=box, style=filled, fillcolor="#eeeeee", label=<Lưu lịch làm việc<BR/><FONT POINT-SIZE="4"> </FONT><BR/><FONT POINT-SIZE="12"><I>Hệ thống · CN 1.2 · ghi D1</I></FONT>>];
  P10 [shape=box, style="rounded,bold", penwidth=1.6, label=<<B>[10]</B> Danh mục thuốc<BR/><FONT POINT-SIZE="4"> </FONT><BR/><FONT POINT-SIZE="12"><I>CN 1.3 · đọc D3 · tìm theo tên, nhóm</I></FONT>>];
  P11 [shape=box, style="rounded,bold", penwidth=1.6, label=<<B>[11]</B> Thêm, sửa thuốc<BR/><FONT POINT-SIZE="4"> </FONT><BR/><FONT POINT-SIZE="12"><I>Mã, tên, hàm lượng, đơn vị, nhóm, liều tối đa, lưu ý</I></FONT>>];
  Q5 [shape=diamond, fontsize=13, label=<Thông tin<BR/>hợp lệ?>];
  N5 [shape=note, label=<Báo lỗi dưới<BR/>ô nhập sai>];
  W5 [shape=box, style=filled, fillcolor="#eeeeee", label=<Lưu thuốc<BR/><FONT POINT-SIZE="4"> </FONT><BR/><FONT POINT-SIZE="12"><I>Hệ thống · CN 1.3 · ghi D3</I></FONT>>];
  P12 [shape=box, style="rounded,bold", penwidth=1.6, label=<<B>[12]</B> Tài khoản người dùng<BR/><FONT POINT-SIZE="4"> </FONT><BR/><FONT POINT-SIZE="12"><I>CN 1.4 · đọc D7 · lọc theo vai trò</I></FONT>>];
  Q3 [shape=diamond, fontsize=13, label=<Thao tác?>];
  W3 [shape=box, style=filled, fillcolor="#eeeeee", label=<Khóa / mở khóa tài khoản<BR/><FONT POINT-SIZE="4"> </FONT><BR/><FONT POINT-SIZE="12"><I>Hệ thống · ghi D7 · không tự khóa mình</I></FONT>>];
  P13 [shape=box, style="rounded,bold", penwidth=1.6, label=<<B>[13]</B> Thêm, sửa tài khoản<BR/><FONT POINT-SIZE="4"> </FONT><BR/><FONT POINT-SIZE="12"><I>Họ tên, tên đăng nhập, vai trò, bác sĩ liên kết, mật khẩu</I></FONT>>];
  Q4 [shape=diamond, fontsize=13, label=<Hợp lệ?>];
  N4 [shape=note, label=<Tên đăng nhập trùng, bác sĩ<BR/>đã có tài khoản, mật khẩu &lt; 6 ký tự>];
  W4 [shape=box, style=filled, fillcolor="#eeeeee", label=<Lưu tài khoản<BR/><FONT POINT-SIZE="4"> </FONT><BR/><FONT POINT-SIZE="12"><I>Hệ thống · CN 1.4 · ghi D7</I></FONT>>];
  E [shape=oval, style=bold, penwidth=1.6, label=<<B>Kết thúc</B>>];
  S -> Q0;
  Q0 -> P7 [label=<Bác sĩ>];
  Q0 -> P10 [label=<Thuốc>];
  Q0 -> P12 [label=<Tài khoản>];
  P7 -> P8 [label=<Thêm / Sửa>];
  P8 -> Q1;
  Q1 -> N1 [label=<Không>];
  N1 -> P8 [constraint=false];
  Q1 -> W1 [label=<  Có>];
  W1 -> P7 [constraint=false];
  P7 -> P9 [label=<Lịch làm việc>];
  P9 -> Q2;
  Q2 -> N2 [label=<Không>];
  N2 -> P9 [constraint=false];
  Q2 -> W2 [label=<  Có>];
  W2 -> E;
  W1 -> E;
  P10 -> P11 [label=<Thêm / Sửa>];
  P11 -> Q5;
  Q5 -> N5 [label=<Không>];
  N5 -> P11 [constraint=false];
  Q5 -> W5 [label=<  Có>];
  W5 -> P10 [constraint=false];
  W5 -> E;
  P12 -> Q3;
  Q3 -> W3 [label=<Khóa /<BR/>mở khóa>];
  W3 -> P12 [constraint=false];
  Q3 -> P13 [label=<Thêm / Sửa>];
  P13 -> Q4;
  Q4 -> N4 [label=<Không>];
  N4 -> P13 [constraint=false];
  Q4 -> W4 [label=<  Có>];
  W4 -> E;
  subgraph cluster_legend {
    label=<<B>Chú thích</B>>; fontsize=13; style=dashed; color="#888888"; labeljust=l; margin=12;
    node [fontsize=12, margin="0.12,0.05"];
    G1 [shape=oval, style=bold, label=<Bắt đầu / Kết thúc>];
    G2 [shape=box, style="rounded,bold", label=<[n] Màn hình người dùng>];
    G3 [shape=box, style=filled, fillcolor="#eeeeee", label=<Hệ thống xử lý>];
    G4 [shape=diamond, label=<Rẽ nhánh>];
    G5 [shape=note, label=<Thông báo / phiếu>];
    G6 [shape=cds, label=<Sang luồng khác>];
    {rank=same; G1; G2; G3; G4; G5; G6;}
    G1 -> G2 -> G3 -> G4 -> G5 -> G6 [style=invis];
  }
  E -> G3 [style=invis];
}
